package tauri:backend@0.1.0;

/// Functions the Tauri app (the host) provides to WASM backend modules.
///
/// Every call is checked against the capabilities granted to the module, the
/// same way frontend IPC is checked against Tauri capabilities.
interface host {
  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  /// Write a message to the app's log (the `log` crate on the Rust side).
  log: func(level: log-level, message: string);

  /// Emit a Tauri event to the frontend and Rust listeners.
  /// `payload` is a JSON document. Requires the event to be allowed by the
  /// module's `events.emit` capability.
  emit: func(event: string, payload: string) -> result<_, string>;

  /// Invoke a host command registered by the app with
  /// `Builder::host_command`. `args` is a JSON document and the result is a
  /// JSON document. Requires the command to be allowed by the module's
  /// `hostCommands` capability.
  ///
  /// Host commands can also be imported as typed functions: every function
  /// a module imports from an interface outside `wasi:*` and `tauri:backend/*`
  /// is backed by the host command of the same name, and checked when the
  /// module loads.
  invoke: func(command: string, args: string) -> result<string, string>;
}

/// A small key-value store of the module's own, kept by the host. A module's
/// memory is reset when it is reloaded or traps; what it stores here is not,
/// and the app can keep it between runs.
///
/// Import it in your world next to the base world:
///
/// ```wit
/// world counter {
///   include tauri:backend/module@0.1.0;
///   import tauri:backend/state@0.1.0;
///   export next: func() -> u32;
/// }
/// ```
///
/// Every key is checked against the module's `state` capability. Writes made
/// during a call are kept when the call returns and dropped if it traps, so
/// a crash never leaves half an update behind.
interface state {
  /// The value under `key`, if there is one.
  get: func(key: string) -> result<option<string>, string>;
  /// Store `value` under `key`. Keys are at most 256 bytes and values at
  /// most 64 KiB.
  set: func(key: string, value: string) -> result<_, string>;
  /// Remove `key`, if it is there.
  remove: func(key: string) -> result<_, string>;
  /// Every key in the store the module's capability reaches, sorted.
  keys: func() -> result<list<string>, string>;
}

/// Optional interface a module exports to receive app events it subscribed
/// to through the `events.listen` capability.
interface events {
  /// `payload` is the event's JSON payload.
  on-event: func(event: string, payload: string);
}

/// Base world for a backend module. Include it in your own world and export
/// your commands as top-level functions, e.g.
///
/// ```wit
/// world greeter {
///   include tauri:backend/module@0.1.0;
///   export greet: func(name: string) -> string;
/// }
/// ```
world module {
  import host;
}

/// Same as `module`, plus event handling.
world module-with-events {
  import host;
  export events;
}

/// Everything the host provides. Guests don't need it: import `state` in
/// your own world, as shown on the interface.
world host-imports {
  import host;
  import state;
}
