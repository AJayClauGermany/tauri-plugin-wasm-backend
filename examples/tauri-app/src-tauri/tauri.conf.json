{
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "tauri-app",
        "width": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../wasm/dist/": "wasm/"
    }
  },
  "plugins": {
    "wasm-backend": {
      "modules": {
        "greeter": {
          "path": "wasm/greeter.wasm",
          "devPath": "../wasm/dist/greeter.wasm",
          "capabilities": {
            "hostCommands": [
              "app_version"
            ],
            "events": {
              "emit": [
                "greeter://*"
              ],
              "listen": [
                "app://ping"
              ]
            },
            "timeoutMs": 1000
          }
        },
        "stats": {
          "path": "wasm/stats.wasm",
          "devPath": "../wasm/dist/stats.wasm",
          "capabilities": {
            "events": {
              "emit": [
                "stats://computed"
              ]
            }
          }
        }
      },
      "external": {
        "dir": "$APPDATA/plugins",
        "capabilities": {
          "events": {
            "emit": [
              "plugin://*"
            ]
          }
        }
      },
      "typescriptOutDir": "../src/lib/wasm"
    }
  }
}
