{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "wasm-backend:default",
    "wasm-backend:allow-reload-module",
    {
      "identifier": "wasm-backend:allow-invoke",
      "allow": [
        {
          "module": "stats",
          "command": "summarize"
        }
      ]
    }
  ]
}
